<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F5F5F5">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ai Assistant"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="12dp"
        android:textColor="#333333"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvModuleName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Модуль"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#444444"/>

        <TextView
            android:id="@+id/tvHelp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="help"
            android:textColor="#1976D2"
            android:textSize="14sp"
            android:padding="8dp"/>
    </LinearLayout>

    <!-- Контейнер для кнопок команд (динамически заполняется в ModuleActivity) -->
    <LinearLayout
        android:id="@+id/llCommandsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="12dp"/>

    <TextView
        android:id="@+id/tvCommandStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Готово"
        android:gravity="center"
        android:padding="4dp"
        android:textColor="#666666"
        android:textSize="12sp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Логи"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        android:textColor="#555555"/>

    <ScrollView
        android:id="@+id/scrollLogs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#1E1E1E"
        android:padding="8dp"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/tvLogs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#D4D4D4"
            android:fontFamily="monospace"
            android:textSize="12sp"/>
    </ScrollView>
</LinearLayout>
